NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clerk owns sign-in. The Supabase project must trust this Clerk instance
# (Authentication → Third-party auth → Clerk) for RLS reads to see the caller.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Preferred open-weight inference provider. Server only. Configure with:
# python3 scripts/configure-fireworks.py
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Optional investigator override; defaults to FIREWORKS_MODEL.
FIREWORKS_INVESTIGATOR_MODEL=
# Required in production to scope environment fallback to ONE workspace UUID.
# Multi-tenant deployments should configure encrypted keys per org in Settings.
LLM_ENV_ORG_ID=

# Required to save provider API keys. A random 32+ char string; used to derive the
# AES-256-GCM key that encrypts org_model_configs.api_key_ciphertext (Plan 2, D-P2).
# Rotating this invalidates every stored key — users must re-enter them.
LLM_KEY_ENCRYPTION_SECRET=

# Optional (Plan 2, D-P13). When set to 1 AND NODE_ENV=production, config-save
# rejects base_url hosts on private/localhost ranges (SSRF guard). Default off so
# self-hosters can point at http://localhost:11434 (Ollama) or a VPC endpoint.
LLM_BLOCK_PRIVATE_URLS=

# Self-host fallback (Plan 2, D-P4). When an org has zero active model configs, the
# router treats this key as an implicit Anthropic config (default_model
# claude-sonnet-4-6) so `next dev` demos work with nothing but this env var.
ANTHROPIC_API_KEY=

# Optional: lower the hard 256 KiB ceiling on serialized model inputs.
LLM_MAX_INPUT_BYTES=262144
